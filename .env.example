# Environment variables for PRODUCTION (set these in Railway → service → Variables).
# These document the shape only — never commit real secrets (this repo is public).

# Symfony
APP_ENV=prod
APP_SECRET=__generate__            # openssl rand -hex 16

# Database — on Railway, reference the Postgres plugin:  ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/dbname?serverVersion=16&charset=utf8

# Real-time (Mercure). PUBLIC_URL must be the public https domain; URL is the
# in-container hub. The three JWT values must be IDENTICAL (one shared secret).
MERCURE_PUBLIC_URL=https://social-playlist.com/.well-known/mercure
MERCURE_URL=http://127.0.0.1:${PORT}/.well-known/mercure
MERCURE_JWT_SECRET=__generate__            # openssl rand -hex 32
MERCURE_PUBLISHER_JWT_KEY=__same_as_above__
MERCURE_SUBSCRIBER_JWT_KEY=__same_as_above__

# Behind Cloudflare + Railway's proxy — trust forwarded headers.
# (Set to the proxy IPs, or use the value below to trust the immediate upstream.)
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
