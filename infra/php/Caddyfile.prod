# Production FrankenPHP / Caddy config.
# Serves the Astro spectator SITE (static files in /app/public) at `/`, and the API at `/api` —
# same origin (no CORS), one deploy. Listens on $PORT; TLS terminated upstream (Railway/Cloudflare).
{
	frankenphp
	order php_server before file_server
	order mercure after encode
}

:{$PORT:8000} {
	root * /app/public
	encode zstd br gzip

	# Real-time hub: anonymous subscribe (public spectating); publish requires the JWT.
	handle /.well-known/mercure* {
		mercure {
			publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY}
			subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
			anonymous
		}
	}

	# API + Symfony front controller → PHP.
	handle /api* {
		php_server
	}
	handle /index.php* {
		php_server
	}

	# Everything else → the static spectator site (Astro build) + other public files
	# (/llms.txt, /chatgpt/openapi.json). SPA-style fallback to index.html.
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
