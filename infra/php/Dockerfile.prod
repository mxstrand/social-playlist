# Production image for the Social Playlist API (FrankenPHP).
# Build context = repo ROOT (so we can COPY api/). Railway builds this via railway.json.
FROM dunglas/frankenphp:1-php8.4

RUN install-php-extensions intl pdo_pgsql opcache zip @composer

# Prod Caddyfile: listens on $PORT, serves /app/public, runs the Mercure hub.
COPY infra/php/Caddyfile.prod /etc/frankenphp/Caddyfile

WORKDIR /app

ENV APP_ENV=prod

# Install PHP deps first for layer caching (no dev deps, no scripts at build time —
# scripts need runtime env, so we defer cache:clear/assets to the entrypoint).
COPY api/composer.json api/composer.lock api/symfony.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader

# App code (vendor/var excluded via .dockerignore), then authoritative autoload.
COPY api/ ./
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

# Migrate + warm + serve.
COPY infra/php/docker-entrypoint.prod.sh /usr/local/bin/sp-entrypoint
RUN chmod +x /usr/local/bin/sp-entrypoint

ENTRYPOINT ["sp-entrypoint"]
