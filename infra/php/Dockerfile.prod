# Production image for the Social Playlist API (FrankenPHP).
# Build context = repo ROOT (so we can COPY api/). Railway builds this via railway.json.
FROM dunglas/frankenphp:1-php8.4

RUN install-php-extensions intl pdo_pgsql opcache zip @composer

# Prod Caddyfile: listens on $PORT, serves /app/public, runs the Mercure hub.
COPY infra/php/Caddyfile.prod /etc/frankenphp/Caddyfile

WORKDIR /app
ENV APP_ENV=prod

# Full app code first (vendor/ and var/ are excluded via .dockerignore).
COPY api/ ./

# Install prod deps with scripts ENABLED so the symfony/runtime Composer plugin
# generates vendor/autoload_runtime.php (required by bin/console & public/index.php),
# and Flex warms the prod cache. cache:clear / assets:install resolve env lazily, so no
# DATABASE_URL/APP_SECRET are needed at build time. (A two-step --no-scripts install does
# NOT reliably create autoload_runtime.php on clean builders — that broke the first deploy.)
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --classmap-authoritative

# Migrate + seed + warm + serve.
COPY infra/php/docker-entrypoint.prod.sh /usr/local/bin/sp-entrypoint
RUN chmod +x /usr/local/bin/sp-entrypoint

ENTRYPOINT ["sp-entrypoint"]
