# Production image for Social Playlist: the API + the spectator site, served from one app.
# Build context = repo ROOT. Railway builds this via railway.json.

# ── Stage 1: build the Astro spectator site (served at /) ──
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

# ── Stage 2: PHP app (FrankenPHP) ──
FROM dunglas/frankenphp:1-php8.4

# PHP extensions for Symfony 7 + API Platform + Postgres. Assert they loaded so a bad
# install fails the BUILD instead of crash-looping at runtime.
RUN install-php-extensions intl pdo_pgsql opcache zip @composer \
    && php -m | grep -qi '^pdo_pgsql$' \
    && php -m | grep -qi '^intl$'

# FrankenPHP reads its Caddyfile here; ours serves the site at / and the API at /api.
COPY infra/php/Caddyfile.prod /etc/frankenphp/Caddyfile

WORKDIR /app
ENV APP_ENV=prod
# Railway builds as ROOT; Composer disables plugins as root unless this is set (→ no
# autoload_runtime.php + "symfony-cmd not found"). This single line makes the build work on Railway.
ENV COMPOSER_ALLOW_SUPERUSER=1

# 1) Dependencies first — cached on composer.* (only re-runs when the lockfile changes).
COPY api/composer.json api/composer.lock api/symfony.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# 2) App code, then the built spectator site into public/ (served at /).
COPY api/ ./
COPY --from=web /web/dist/ ./public/

# 3) Optimized autoloader (symfony/runtime writes autoload_runtime.php) + warm cache + install assets.
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative \
    && test -f vendor/autoload_runtime.php \
    && php bin/console cache:clear --no-interaction \
    && php bin/console assets:install public --no-interaction

# Migrate + seed + serve.
COPY infra/php/docker-entrypoint.prod.sh /usr/local/bin/sp-entrypoint
RUN chmod +x /usr/local/bin/sp-entrypoint

ENTRYPOINT ["sp-entrypoint"]
